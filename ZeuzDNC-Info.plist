<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>ZeuzDNC</string>

	<!-- iOS 14+ exige pedir permiso para hablar con cualquier equipo de la red
	     local. Sin esto NO funciona ni el SMB ni el puente serial por TCP:
	     las conexiones fallan en silencio. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>ZeuzDNC necesita la red local para leer los programas de la carpeta compartida y para enviar el G-code al puente serial de la maquina.</string>

	<!-- Permite descubrir servidores SMB y puentes seriales por Bonjour. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_smb._tcp</string>
		<string>_device-info._tcp</string>
	</array>

	<!-- Protocolos de accesorio MFi. Solo cables certificados: un adaptador
	     USB-RS232 generico (FTDI, CH340, PL2303) NO aparece aqui porque iOS
	     no lo reconoce. Ajusta la cadena a la del cable que uses; debe
	     coincidir con la configurada en el puerto dentro de la app. -->
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.redpark.hobdb9</string>
		<string>com.redpark.L2-DB9</string>
	</array>

	<!-- Mantiene viva la sesion con el cable mientras corre una transferencia
	     larga en goteo con la pantalla apagada. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>external-accessory</string>
	</array>

	<!-- Pantalla de lanzamiento lisa: sin UIColorName usa el fondo del sistema
	     y respeta modo claro/oscuro. Un UIColorName vacio NO es valido. -->
	<key>UILaunchScreen</key>
	<dict/>

	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
